generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  images       Image[]
  resizeJobs   ResizeJob[]
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Image {
  id           String      @id @default(cuid())
  userId       String
  originalName String
  storageKey   String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resizeJobs ResizeJob[]

  @@index([userId])
  @@map("images")
}

model ResizeJob {
  id          String       @id @default(cuid())
  userId      String
  imageId     String

  width       Int?
  height      Int?
  quality     Int?
  format      ImageFormat  @default(JPEG)

  outputKey   String?
  outputSize  Int?
  status      ResizeStatus @default(PENDING)
  error       String?

  createdAt   DateTime     @default(now())
  completedAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([imageId])
  @@index([status])
  @@map("resize_jobs")
}

enum ImageFormat {
  JPEG
  PNG
  WEBP
  AVIF
}

enum ResizeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
