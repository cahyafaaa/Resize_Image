# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ==========================================
# 1. Environment & Secret Credentials (SANGAT PENTING)
# ==========================================
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.example


# ==========================================
# 2. User Uploads & File Storage (Data Pengguna)
# ==========================================
/storage
/storage/**
/uploads
/uploads/**
/public/uploads
/public/uploads/**
tmp/
temp/

# ==========================================
# 3. Dependencies
# ==========================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# 4. Build Outputs & Caches
# ==========================================
/.next/
/out/
/build
/dist
.vercel
*.tsbuildinfo
next-env.d.ts

# ==========================================
# 5. Database Files (Local DB & Cache)
# ==========================================
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
/app/generated/prisma

# ==========================================
# 6. Certificates & Private Keys
# ==========================================
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ==========================================
# 7. Debug & Log Files
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# ==========================================
# 8. Testing & Coverage
# ==========================================
/coverage

# ==========================================
# 9. Operating System & IDE Files
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
